# ==========================================================================
# ChittyFund — Environment Configuration
# --------------------------------------------------------------------------
# Copy to .env and fill in real values. NEVER commit a real .env or any
# secret keys. Local development can run entirely on SQLite (default below).
# Production targets MySQL 8+ and Redis (see the commented blocks).
# ==========================================================================

APP_NAME=ChittyFund
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

# Supported locales: en (English), ml (Malayalam)
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------
# Local default: SQLite (zero-config). For production use MySQL 8+.
DB_CONNECTION=sqlite

# --- MySQL 8+ (production) — uncomment and set values ---------------------
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=chittyfund
# DB_USERNAME=chittyfund
# DB_PASSWORD=

# --------------------------------------------------------------------------
# Session / Cache / Queue
# --------------------------------------------------------------------------
# Local defaults use the database driver so no Redis is required.
# In production, switch these to redis and configure the Redis block below.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Redis (production: cache, queues, sessions, broadcasting) ------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# When Redis is available, prefer:
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# SESSION_DRIVER=redis

# --------------------------------------------------------------------------
# Broadcasting / Real-time (Phase 3: live auctions)
# --------------------------------------------------------------------------
# Options: log (local), reverb (self-hosted WebSockets), pusher.
BROADCAST_CONNECTION=log

# Laravel Reverb (self-hosted WebSocket server)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Pusher (alternative to Reverb)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap2

# Set to "1" to force the secure long-polling fallback for auctions on hosts
# that cannot maintain WebSocket connections (e.g. shared cPanel).
AUCTION_POLLING_FALLBACK=0

# --------------------------------------------------------------------------
# Filesystem (KYC docs & receipts must use a PRIVATE disk in production)
# --------------------------------------------------------------------------
FILESYSTEM_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --------------------------------------------------------------------------
# Mail (SMTP)
# --------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@chittyfund.test"
MAIL_FROM_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# Payment Gateways (Phase 2) — server-side keys only, NEVER expose to client
# --------------------------------------------------------------------------
PAYMENT_DEFAULT_GATEWAY=razorpay

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# --------------------------------------------------------------------------
# WhatsApp / SMS Notifications (Phase 4)
# --------------------------------------------------------------------------
# Provider abstraction: meta | twilio | interakt | gupshup
WHATSAPP_PROVIDER=meta
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --------------------------------------------------------------------------
# Mobile push (Phase 5)
# --------------------------------------------------------------------------
EXPO_ACCESS_TOKEN=

VITE_APP_NAME="${APP_NAME}"
